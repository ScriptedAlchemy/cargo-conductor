{
  "name": "cargo-conductor",
  "version": "0.1.18",
  "license": "MIT",
  "private": true,
  "description": "Orchestrate cargo across Claude, Codex, and Cursor so concurrent agent sessions share work instead of fighting locks.",
  "keywords": [
    "cargo",
    "rust",
    "agent",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "build-orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScriptedAlchemy/cargo-conductor.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cargo-conductor": "./dist/bin/cargo-conductor.js"
  },
  "scripts": {
    "build": "agent-bundle build --output artifact",
    "check": "npm run validate && npm run build && npm run typecheck && npm run diagnostics && npm run test",
    "dev": "agent-bundle dev",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "rstest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "agent-bundle validate",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@agent-bundle/rsc-runtime": "https://pkg.pr.new/ScriptedAlchemy/agent-bundle/@agent-bundle/rsc-runtime@560124af",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@modelcontextprotocol/server": "2.0.0",
    "bashjsast": "github:woolkingx/bashjsast#131f4b677d1906774fc49cfceab0ccb7b370b2e6",
    "effect": "4.0.0-rc.112",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scheduler": "^0.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@rstest/core": "0.11.10",
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "agent-bundle": "https://pkg.pr.new/ScriptedAlchemy/agent-bundle/agent-bundle@560124af",
    "typescript": "7.0.2"
  }
}
